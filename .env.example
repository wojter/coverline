# Copy to .env and fill in. Never commit .env.

# prod, or dev for local runs only
ENV=prod
# cloudflare in production, dev only for local runs (ENV must be dev)
AUTH_MODE=cloudflare
# Cloudflare Access: team domain (also the expected JWT issuer) and the AUD tag of the API app
CF_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
CF_ACCESS_AUD=<aud tag of the API Access app>
# Service token Client IDs mapped to device labels: <client_id>=<label>,<client_id>=<label>
ALLOWED_SERVICE_TOKENS=<client_id_ios>.access=ios,<client_id_android>.access=android,<client_id_pc>.access=pc

# Tunnel token from the Cloudflare dashboard (cloudflared reads it from the environment)
TUNNEL_TOKEN=<tunnel token>
